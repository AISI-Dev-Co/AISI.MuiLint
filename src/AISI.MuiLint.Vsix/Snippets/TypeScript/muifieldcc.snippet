<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI field that commits changes</Title>
      <Shortcut>muifieldcc</Shortcut>
      <Description>A field that sends its value to the server as soon as it changes.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>The field's name, exactly as the DAC spells it.</ToolTip>
          <Default>FieldName</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[$name$: PXFieldState<PXFieldOptions.CommitChanges>;$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
