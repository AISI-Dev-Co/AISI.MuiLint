<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI view class</Title>
      <Shortcut>muiviewclass</Shortcut>
      <Description>A new view class with its first field.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>class</ID>
          <ToolTip>The view class.</ToolTip>
          <Default>SOLine</Default>
        </Literal>
        <Literal>
          <ID>field</ID>
          <ToolTip>The field's name, exactly as the DAC spells it.</ToolTip>
          <Default>FieldName</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[export class $class$ extends PXView {
	$field$: PXFieldState;$end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
