<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI CallbackCompleted handler</Title>
      <Shortcut>muioncallback</Shortcut>
      <Description>Runs when a callback to the server has completed.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>The handler's name; keep it unlike any method the screen already has.</ToolTip>
          <Default>onCallbackCompleted</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[@handleEvent(CustomEventType.CallbackCompleted)
$name$(args: CallbackCompletedHandlerArgs<any>) {
	$end$
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
