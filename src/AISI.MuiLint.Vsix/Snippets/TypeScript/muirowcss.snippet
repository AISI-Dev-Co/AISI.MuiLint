<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI GetRowCss handler</Title>
      <Shortcut>muirowcss</Shortcut>
      <Description>Returns a CSS class for a row of a grid, or undefined.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>view</ID>
          <ToolTip>The grid's view on the screen class.</ToolTip>
          <Default>Transactions</Default>
        </Literal>
        <Literal>
          <ID>name</ID>
          <ToolTip>The handler's name; keep it unlike any method the screen already has.</ToolTip>
          <Default>getTransactionsRowCss</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[@handleEvent(CustomEventType.GetRowCss, { view: "$view$" })
$name$(args: RowCssHandlerArgs): string | undefined {
	$end$
	return undefined;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
