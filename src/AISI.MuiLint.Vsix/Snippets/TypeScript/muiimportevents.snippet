<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI event imports</Title>
      <Shortcut>muiimportevents</Shortcut>
      <Description>The client-controls import for event handlers.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="TypeScript"><![CDATA[import { handleEvent, CustomEventType, ValueChangedHandlerArgs, RowSelectedHandlerArgs, CurrentRowChangedHandlerArgs, RowCssHandlerArgs, CellCssHandlerArgs, CallbackCompletedHandlerArgs } from "client-controls";$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
