<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Modern UI GetCellCss handler</Title>
      <Shortcut>muicellcss</Shortcut>
      <Description>Returns a CSS class for one column's cells, or undefined.</Description>
      <Author>AISI Dev Co</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>view</ID>
          <ToolTip>The grid's view on the screen class.</ToolTip>
          <Default>Transactions</Default>
        </Literal>
        <Literal>
          <ID>column</ID>
          <ToolTip>The field of the view's class whose cells to style.</ToolTip>
          <Default>OrderQty</Default>
        </Literal>
        <Literal>
          <ID>name</ID>
          <ToolTip>The handler's name; keep it unlike any method the screen already has.</ToolTip>
          <Default>getOrderQtyCellCss</Default>
        </Literal>
      </Declarations>
      <Code Language="TypeScript"><![CDATA[@handleEvent(CustomEventType.GetCellCss, { view: "$view$", column: "$column$" })
$name$(args: CellCssHandlerArgs): string | undefined {
	$end$
	return undefined;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
