<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AISI.MuiLint.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1859</NoWarn>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AISI.MuiLint\AISI.MuiLint.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AISI.MuiLint.Vsix\MuiLintPackage.cs" Link="MuiLintPackage.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\AISI.MuiLint.Vsix\Editor\HtmlErrorTagger.cs" Link="EditorSnapshots\HtmlErrorTagger.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AISI.MuiLint.Vsix\Editor\HtmlErrorTaggerProvider.cs" Link="EditorSnapshots\HtmlErrorTaggerProvider.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AISI.MuiLint.Vsix\Editor\MuiLintVsPackage.cs" Link="EditorSnapshots\MuiLintVsPackage.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AISI.MuiLint.Vsix\Editor\HtmlCompletionSource.cs" Link="EditorSnapshots\HtmlCompletionSource.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
