<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="AISI.MuiLint.10c4e8a7-6b91-4f3d-9a2c-7e5d1b8f4a10" Version="0.2.0" Language="en-US" Publisher="AISI Dev Co" />
    <DisplayName>AISI MuiLint</DisplayName>
    <Description xml:space="preserve">Catches Acumatica Modern UI HTML merge traps as you type: self-closing field/qp-* tags, selectors that point at your own fields or at nothing in the stock screen, malformed selectors, extensions with no matching .ts, duplicate ids, empty fieldsets, misplaced files, views, fields and actions your screen's TypeScript never declares, and half-written TypeScript extensions. Lightbulb fixes that write the TypeScript for you, completions from the stock screen, the .ts and your C# DAC extensions, go to definition and hover, and .editorconfig severities. Acuminator lints your C#; MuiLint lints your Modern UI HTML.</Description>
    <MoreInfo>https://www.aisidev.com/</MoreInfo>
    <License>LICENSE</License>
    <Tags>acumatica;modern-ui;html;merge;linter;analyzer;erp</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="AISI.MuiLint.Vsix" Path="|AISI.MuiLint.Vsix;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="AISI.MuiLint.Snippets.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="AISI.MuiLint.Vsix" Path="|AISI.MuiLint.Vsix|" />
    <Asset Type="Microsoft.VisualStudio.Analyzer" d:Source="Project" d:ProjectName="AISI.MuiLint" Path="|AISI.MuiLint|" />
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="AISI.MuiLint" Path="|AISI.MuiLint|" />
  </Assets>
</PackageManifest>
